{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "twokey hook claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "twokey hook claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "twokey hook claude",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(.twokey.toml)",
      "Write(.twokey.toml)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)"
    ]
  }
}
