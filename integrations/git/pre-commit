#!/bin/sh
# Install with:  git config core.hooksPath .githooks  &&  cp this .githooks/pre-commit
#
# Local seatbelt: checks the staged change before it becomes a commit. AI-ness is
# decided by env vars (e.g. CLAUDECODE, TWOKEY_AI) and branch name from the
# policy's [ai] section. `--no-verify` skips it, so CI remains the authority.
command -v twokey >/dev/null 2>&1 || { echo "twokey not installed; skipping" >&2; exit 0; }
twokey check --staged
status=$?
case $status in
  0) exit 0 ;;
  3) echo "twokey: needs human approval; commit allowed, but the PR will require sign-off." >&2; exit 0 ;;
  *) exit $status ;;
esac
