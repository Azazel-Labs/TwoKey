#!/bin/sh
# Install this file as .githooks/pre-commit, make it executable on Unix,
# then run: git config core.hooksPath .githooks
# This runs before a commit message exists, so changes default to AI.
# Prefer the commit-msg hook when using configured human declarations.
# Local feedback only: --no-verify skips it, so CI remains the authority.
command -v twokey >/dev/null 2>&1 || { echo "twokey is required for this hook" >&2; exit 2; }
exec twokey check --staged --require-policy
